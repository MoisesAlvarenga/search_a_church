{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=search_a_church_db;Username=postgres;Password=YOUR_POSTGRES_PASSWORD",
    "Redis": "localhost:6379"
  },
  "Jwt": {
